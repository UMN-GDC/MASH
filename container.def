Bootstrap: localimage
From: /scratch.global/coffm049/baseImage/base.sif

%post
    micromamba shell reinit
    micromamba create -n MASH python pip -y -c conda-forge
    micromamba clean --all
    /opt/conda/envs/MASH/bin/pip --root-user-action install git+https://github.com/UMN-GDC/MASH.git

%environment
    # Ensure the locale is set correctly (prevents Python unicode errors)
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export PATH="/bin:/opt/conda/bin:/opt/conda/envs/MASH/bin:/usr/bin:$PATH"

%runscript
    # This runs when you execute the container file directly
    echo "Container ready."
    echo "Available commands: 'MASH' and 'SimulateMASH'"
    exec "$@"

%labels
    Author Christian Coffman
    Version v0.0.1

